
// ── GRUPO 1: Machine Learning ─────────────────────────────────────

/// ml.ajustar(X, y) → Result<[Decimal]>
/// Regresión lineal por mínimos cuadrados.
/// X debe incluir columna de unos: [[1, x1], [1, x2], ...]
/// Devuelve Ok([β0, β1, ...]) o Err(msg).
ml_ajustar(X, y) => prim_ml_ajustar_lineal(X, y)

/// ml.r2(y_real, y_pred) → Decimal
/// Coeficiente de determinación R² ∈ (-∞, 1].
ml_r2(y_real, y_pred) => prim_ml_r2(y_real, y_pred)

/// Auxiliar: añade columna de unos a una lista plana de x.
/// Convierte [x1, x2, ...] en [[1, x1], [1, x2], ...]
prim_ml_agregar_bias(x) =>
    return map(x, (xi) => [1.0, decimal(xi)])
end

/// ml.predecir(coefs, x) → Decimal
/// Calcula β0 + β1*x usando los coeficientes del modelo.
ml_predecir(coefs, x) =>
    return coefs[0] + coefs[1] * decimal(x)
end

/// ml.predecir_multiple(coefs, fila) → Decimal
/// Para regresión múltiple: β0 + β1*x1 + β2*x2 + ...
/// fila: [x1, x2, ...] (sin el 1 de bias)
ml_predecir_multiple(coefs, fila) =>
    var suma = coefs[0]
    var i = 1
    while i < long(coefs):
        suma = suma + coefs[i] * decimal(fila[i - 1])
        i = i + 1
    end
    return suma
end