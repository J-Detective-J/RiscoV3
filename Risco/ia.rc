// ── GRUPO 1: Machine Learning ──────────────────────────────────────

ai_config(epocas, tasa, alpha) => [epocas, tasa, alpha]

ai_config_activacion(epocas, tasa, alpha, activacion) => [epocas, tasa, alpha, activacion]

/// ml.ajustar(X, y, cfg) → Result<[pesos, bias, historial]>
/// X: lista plana de x, NO hace falta agregar columna de 1s.
ml_ajustar(X, y, cfg) => prim_ml_ajustar_lineal(X, y, cfg)

/// ml.predecir(modelo, x) → Decimal
/// x: valor escalar o lista [x1, x2, ...]
ml_predecir(modelo, x) =>
    val w = modelo[0]
    val b = modelo[1]
    if long(w) == 1:
        return b + w[0] * x[0]
    end
    var suma = b
    var i = 0
    while i < long(w):
        suma = suma + w[i] * x[i]
        i = i + 1
    end
    return suma
end

/// ml.historial(modelo) → [Decimal]
ml_historial(modelo) => modelo[2]

/// ml.r2(y_real, y_pred) → Decimal
ml_r2(y_real, y_pred) => prim_ml_r2(y_real, y_pred)
/// ml.logistic.ajustar(X, y, cfg) → Result<[pesos, bias, historial, medias, desviaciones]>
ml_logistic_ajustar(X, y, cfg) => prim_ml_ajustar_logistico(X, y, cfg)

/// ml.logistic.prob(modelo, x) → Decimal
ml_logistic_prob(modelo, x) => prim_ml_logistic_prob(modelo, x)

/// ml.logistic.clasificar(modelo, x) → Num
ml_logistic_clasificar(modelo, x) =>
    var prob = ml_logistic_prob(modelo, x)
    if prob >= 0.5:
        return 1
    end
    return 0
end

ml_knn_ajustar(X, y, k, tipo, metrica) => prim_ml_knn_ajustar(X, y, k, tipo, metrica)

ml_knn_predecir(modelo, muestra) => prim_ml_knn_predecir(modelo, muestra)

// ── GRUPO 2: Deep Learning ──────────────────────────────────────

/// perceptron.ajustar(X, y, cfg) → [pesos, bias, historial]
perceptron_ajustar(X, y, cfg) =>
    if long(cfg) == 4:
        return prim_perceptron_fit(X, y, cfg[0], cfg[1], cfg[3])
    end
    return prim_perceptron_fit(X, y, cfg[0], cfg[1])
end

/// perceptron.predecir(modelo, X) → [Decimal]
perceptron_predecir(modelo, X) => prim_perceptron_predict(modelo[0], modelo[1], X)

/// mlp.config(capas, epocas, tasa, alpha, activacion, tipo) → Config
/// capas: lista de neuronas por capa oculta, ej. [4, 4]
/// activacion: "sigmoid", "tanh", "relu"
/// tipo: "clasificacion" o "regresion"
mlp_config(capas, epocas, tasa, alpha, activacion, tipo) =>
    return [capas, epocas, tasa, alpha, activacion, tipo]
end

/// mlp.ajustar(X, y, cfg) → Result<modelo>
mlp_ajustar(X, y, cfg) =>
    return prim_mlp_fit(X, y, cfg[0], cfg[1], cfg[2], cfg[3], cfg[4], cfg[5])
end

/// mlp.prob(modelo, x) → Decimal   (clasificación: prob de clase 1)
mlp_prob(modelo, x) => prim_mlp_predict_prob(modelo, x)

/// mlp.clasificar(modelo, x) → Num  (0 o 1)
mlp_clasificar(modelo, x) => prim_mlp_predict_clase(modelo, x)

/// mlp.predecir_batch(modelo, X) → [Decimal]
/// Para clasificación retorna lista de 0.0/1.0, para regresión valores continuos
mlp_predecir_batch(modelo, X) => prim_mlp_predict_batch(modelo, X)

/// mlp.predecir(modelo, x) → Decimal  (regresión)
mlp_predecir(modelo, x) => prim_mlp_predict_regression(modelo, x)

/// mlp.historial(modelo) → [Decimal]
mlp_historial(modelo) => modelo[2]

// ── Métricas ──────────────────────────────────────────────────

/// metricas.accuracy(y_real, y_pred) → Decimal
metricas_accuracy(y_real, y_pred) => prim_accuracy(y_real, y_pred)

/// metricas.precision(y_real, y_pred) → Decimal
metricas_precision(y_real, y_pred) => prim_precision(y_real, y_pred)

/// metricas.confusion(y_real, y_pred) → [[Num]]
metricas_confusion(y_real, y_pred) => prim_confusion_matrix(y_real, y_pred)


metricas_recall(y_real, y_pred) => prim_recall(y_real, y_pred)
metricas_f1(y_real, y_pred) => prim_f1(y_real, y_pred)
metricas_mae(y_real, y_pred) => prim_mae(y_real, y_pred)
metricas_mse(y_real, y_pred) => prim_mse(y_real, y_pred)
metricas_rmse(y_real, y_pred) => prim_rmse(y_real, y_pred)